# ===========================================
# Retail ETL Project - Git Ignore
# ===========================================

# Virtual environment
venv/
env/
.venv/

# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables (sensitive data)
.env

# Log files
logs/*.log
*.log

# IDE settings
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Distribution / packaging
dist/
build/
*.egg-info/

# Byte-compiled / optimized files
*.py[cod]
*$py.class
